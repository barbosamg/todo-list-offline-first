{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=todo;Username=todo;Password=todo"
  },
  "Jwt": {
    "Key": "dev-only-secret-change-me-0123456789abcdef",
    "Issuer": "todo-offline",
    "Audience": "todo-offline-app",
    "ExpiresInDays": 7
  },
  "Cors": {
    "Origins": [ "http://localhost:4200", "http://localhost:8080" ]
  },
  "Database": {
    "AutoMigrate": true
  },
  "Seed": {
    "Enabled": true,
    "Email": "demo@way2.dev",
    "Password": "Demo@1234",
    "Name": "Usuário Demo"
  },
  "Webhooks": {
    "MaxAttempts": 8,
    "BatchSize": 50,
    "RequestTimeoutSeconds": 5,
    "PollIntervalMs": 1000,
    "BaseBackoffSeconds": 2,
    "MaxBackoffSeconds": 300,
    "LeaseSeconds": 30,
    "Subscribers": [
      {
        "Name": "external-consumer",
        "Url": "http://localhost:5100/webhooks/todos",
        "Secret": "dev-shared-secret"
      }
    ]
  }
}
